{
 "uid": "shop",
 "title": "Shop SAS — vue d'ensemble",
 "tags": [
  "shop"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Réplicas API up",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(up{job=\"api\"})"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Requêtes/s",
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_request_duration_seconds_count{job=\"api\"}[1m]))"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "% 5xx",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.05
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_request_duration_seconds_count{job=\"api\",status=~\"5..\"}[1m])) / sum(rate(http_request_duration_seconds_count{job=\"api\"}[1m]))"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "p95 API",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\"}[1m])))"
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Alertes actives",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)"
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Commandes traitées / min",
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(orders_processed_total[5m])) * 60"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Requêtes/s par code HTTP",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(http_request_duration_seconds_count{job=\"api\"}[1m]))",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Latence API (p50 / p95 / p99)",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\"}[1m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\"}[1m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\"}[1m])))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Mémoire par conteneur (projet shop)",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "container_memory_working_set_bytes * on (id) group_left (name) docker_container_info{project=\"shop\"}",
     "legendFormat": "{{name}}"
    },
    {
     "refId": "B",
     "expr": "(container_spec_memory_limit_bytes > 0 < 1e15) * on (id) group_left (name) docker_container_info{project=\"shop\"}",
     "legendFormat": "limite {{name}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "CPU par conteneur (projet shop)",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(container_cpu_usage_seconds_total[1m]) * on (id) group_left (name) docker_container_info{project=\"shop\"}",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Réseau reçu par conteneur",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(container_network_receive_bytes_total[1m]) * on (id) group_left (name) docker_container_info{project=\"shop\"}",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Redémarrages / OOM",
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "docker_container_restart_count{project=\"shop\"}",
     "legendFormat": "restarts {{name}}"
    },
    {
     "refId": "B",
     "expr": "docker_container_oom_killed{project=\"shop\"}",
     "legendFormat": "oom {{name}}"
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Worker : commandes traitées",
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(orders_processed_total[1m]))",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 14,
   "type": "logs",
   "title": "Erreurs (Loki : niveau 50 pino / ERROR python)",
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{project=\"shop\", level=~\"50|60|ERROR|CRITICAL\"}"
    }
   ]
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Volume de logs par service et niveau",
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 24,
    "h": 7
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service, level) (count_over_time({project=\"shop\"}[1m]))",
     "legendFormat": "{{service}} {{level}}"
    }
   ]
  }
 ]
}