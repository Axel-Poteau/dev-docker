# Copier en .env (gitignored). Aucun secret ici : le mot de passe BDD est dans secrets/db_password.txt
REGISTRY=localhost:5000
VERSION=1.0
GIT_SHA=unknown
# Port HTTP publié par Traefik (80 par défaut ; 8000 si un serveur web local occupe déjà le 80)
HTTP_PORT=8000
# Port de debug PostgreSQL en dev (5432 par défaut ; 15432 si un PostgreSQL local tourne déjà)
DB_DEBUG_PORT=15432
