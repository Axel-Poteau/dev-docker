# Copier en .env (gitignoré). Aucun secret ici : mots de passe dans secrets/*.txt (make init).
REGISTRY=localhost:5000
VERSION=dev
HTTP_PORT=8090
APP_HOST=geststock.localhost
# prod : relais SMTP de l'entreprise (dev : mailpit)
SMTP_HOST=mailpit
REPORT_TO=direction@shop.example

# fichiers compose de DEV (docker compose les lit sans -f)
COMPOSE_FILE=compose.yml:compose.override.yml:compose.mailpit.yml
